      </column>
      <column caption='% Readmitted' datatype='real' name='[Calculation_2133298895735046153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_704531917374607360]) / SUM([Calculation_2133298895683022848]))*100' />
      </column>
      <column caption='Patient Condition' datatype='string' name='[Calculation_2133298895759450122]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Soft_drink&quot; THEN [Soft_drink]&#13;&#10;    WHEN &quot;HighBlood&quot; THEN [HighBlood]&#13;&#10;    WHEN &quot;Stroke&quot; THEN [Stroke]&#13;&#10;    WHEN &quot;Complication_risk&quot; THEN [Complication_risk]&#13;&#10;    WHEN &quot;Overweight&quot; THEN [Overweight]&#13;&#10;    WHEN &quot;Arthritis&quot; THEN [Arthritis]&#13;&#10;    WHEN &quot;Diabetes&quot; THEN [Diabetes]&#13;&#10;    WHEN &quot;Hyperlipidemia&quot; THEN [Hyperlipidemia]&#13;&#10;    WHEN &quot;BackPain&quot; THEN [BackPain]&#13;&#10;    WHEN &quot;Anxiety&quot; THEN [Anxiety]&#13;&#10;    WHEN &quot;Allergic_rhinitis&quot; THEN [Allergic_rhinitis]&#13;&#10;    WHEN &quot;Reflux_esophagitis&quot; THEN [Reflux_esophagitis]&#13;&#10;    WHEN &quot;Asthma&quot; THEN [Asthma]&#13;&#10;END' />
      </column>
      <column caption='Readmission Status' datatype='integer' name='[Calculation_704531917374607360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ReAdmis] = &quot;Yes&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Overall AVG Survey Rating' datatype='real' name='[Calculation_704531917376995329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;AVG([Item1]) + &#13;&#10;AVG([Item2]) + &#13;&#10;AVG([Item3]) + &#13;&#10;AVG([Item4]) +&#13;&#10;AVG([Item5]) + &#13;&#10;AVG([Item6]) + &#13;&#10;AVG([Item7]) + &#13;&#10;AVG([Item8])&#13;&#10;) / 8' />
      </column>
      <column caption='High Readmission' datatype='string' name='[Calculation_718042716688592896]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2133298895735046153] &gt; 36.69 THEN &quot;Above Overall Rate&quot;&#13;&#10;ELSE &quot;Below Overall Rate&quot;&#13;&#10;END' />
