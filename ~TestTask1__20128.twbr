              <calculation class='tableau' formula='&quot;Asthma&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0v69dea1jgp9s410dudc202bnpq1'>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column caption='Allergic rhinitis' datatype='string' name='[Allergic_rhinitis]' role='dimension' type='nominal' />
