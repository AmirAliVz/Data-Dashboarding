      <aliases enabled='yes' />
      <column caption='Additional charges' datatype='real' name='[Additional_charges]' role='measure' type='quantitative' />
      <column caption='Allergic rhinitis' datatype='string' name='[Allergic_rhinitis]' role='dimension' type='nominal' />
      <column caption='Back Pain' datatype='string' name='[BackPain]' role='dimension' type='nominal' />
      <column caption='GeoDynamic' datatype='string' name='[Calculation_1025413385226194945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;State&quot; THEN [State]&#13;&#10;    WHEN &quot;County&quot; THEN [Calculation_1706019885711761412]&#13;&#10;    WHEN &quot;City&quot; THEN [Calculation_1706019885712531462]&#13;&#10;    WHEN &quot;Zip&quot; THEN STR([Zip])&#13;&#10;END' />
      </column>
      <column caption='Survey Items Dynamic' datatype='integer' name='[Calculation_1272829897833922561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;    WHEN &quot;Timely Admission&quot; THEN [Item1]&#13;&#10;    WHEN &quot;Timely Treatment&quot; THEN [Item2]&#13;&#10;    WHEN &quot;Timely Visits&quot; THEN [Item3]&#13;&#10;    WHEN &quot;Reliability&quot; THEN [Item4]&#13;&#10;    WHEN &quot;Options&quot; THEN [Item5]&#13;&#10;    WHEN &quot;Hours of Treatment&quot; THEN [Item6]&#13;&#10;    WHEN &quot;Courteous Staff&quot; THEN [Item7]&#13;&#10;    WHEN &quot;Evidence of active listening from doctor&quot; THEN [Item8]&#13;&#10;END' />
      </column>
      <column caption='Overall %Readmitted' datatype='real' name='[Calculation_1272829897851314179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Calculation_704531917374607360]) } &#13;&#10;/ { FIXED : COUNT([Calculation_2133298895683022848]) }' />
      </column>
      <column caption='Average Rating ' datatype='real' name='[Calculation_1272829897874022404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([Calculation_1272829897833922561])}' />
      </column>
      <column caption='Patient Priority Level' datatype='string' name='[Calculation_1334191443445035008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1272829897833922561]&#13;&#10;    WHEN 1 THEN &quot;1st&quot;&#13;&#10;    WHEN 2 THEN &quot;2nd&quot;&#13;&#10;    WHEN 3 THEN &quot;3rd&quot;&#13;&#10;    WHEN 4 THEN &quot;4th&quot;&#13;&#10;    WHEN 5 THEN &quot;5th&quot;&#13;&#10;    WHEN 6 THEN &quot;6th&quot;&#13;&#10;    WHEN 7 THEN &quot;7th&quot;&#13;&#10;    WHEN 8 THEN &quot;8th&quot;&#13;&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1626080992881819650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([Age] / 5) * 5) + &quot; - &quot; +&#13;&#10;STR(INT([Age] / 5) * 5 + 4)' />
      </column>
      <column caption='VitD Level Groups' datatype='string' name='[Calculation_1626080992975650819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([VitD_levels] / 0.5) * 0.5) + &quot; - &quot; +&#13;&#10;STR(INT([VitD_levels] / 0.5) * 0.5 + 0.5)' />
      </column>
      <column caption='Initial Days Stayed' datatype='string' name='[Calculation_1626080992976384006]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([Initial_days] / 5) * 5) + &quot; - &quot; +&#13;&#10;STR(INT([Initial_days] / 5) * 5 + 4)' />
      </column>
      <column caption='Income Groups' datatype='string' name='[Calculation_1626080992976912392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([Income] / 4000) * 4000) + &quot; - &quot; +&#13;&#10;STR(INT([Income] / 4000) * 4000 + 4000)' />
      </column>
      <column caption='Case Order Groups' datatype='string' name='[Calculation_1626080992977055753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([CaseOrder] / 400) * 400) + &quot; - &quot; +&#13;&#10;STR(INT([CaseOrder] / 400) * 400 + 399)' />
      </column>
      <column caption='Total Charges' datatype='string' name='[Calculation_1626080993010626570]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([TotalCharge] / 200) * 200) + &quot; - &quot; +&#13;&#10;STR(INT([TotalCharge] / 200) * 200 + 200)' />
      </column>
      <column caption='Additional Charges' datatype='string' name='[Calculation_1626080993011392524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([Additional_charges] / 500) * 500) + &quot; - &quot; +&#13;&#10;STR(INT([Additional_charges] / 500) * 500 + 500)' />
      </column>
      <column caption='DemographicsDynamic' datatype='string' name='[Calculation_1626080993015902222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &quot;Age&quot; THEN [Calculation_1626080992881819650]&#13;&#10;    WHEN &quot;Area&quot; THEN [Area]&#13;&#10;    WHEN &quot;Income&quot; THEN [Calculation_1626080992976912392]&#13;&#10;    WHEN &quot;Marital Status&quot; THEN [Marital]&#13;&#10;    WHEN &quot;Gender&quot; THEN [Gender]&#13;&#10;END' />
      </column>
      <column caption='County level' datatype='string' name='[Calculation_1706019885711761412]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[County] + &quot;, &quot; + [State]' />
      </column>
      <column caption='City Level' datatype='string' name='[Calculation_1706019885712531462]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[City] + &quot;, &quot; + [County] + &quot;, &quot; + [State]' />
      </column>
      <column caption='NumRecords' datatype='integer' name='[Calculation_2133298895683022848]' role='measure' type='quantitative'>
