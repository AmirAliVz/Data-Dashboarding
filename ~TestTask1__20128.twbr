    <worksheet name='Sheet 4'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tw Cen MT Condensed Extra Bold'>Readmission Rate by Hospitalization Information</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tw Cen MT Condensed Extra Bold' fontsize='16'>&lt;[Parameters].[Parameter 3]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Medical Readmission Data' name='federated.0v69dea1jgp9s410dudc202bnpq1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Hospitalization Information' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Services&quot;'>
              <calculation class='tableau' formula='&quot;Services&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0v69dea1jgp9s410dudc202bnpq1'>
            <column caption='Additional charges' datatype='real' name='[Additional_charges]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column caption='VitD Level Groups' datatype='string' name='[Calculation_1626080992975650819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([VitD_levels] / 0.5) * 0.5) + &quot; - &quot; +&#13;&#10;STR(INT([VitD_levels] / 0.5) * 0.5 + 0.5)' />
            </column>
            <column caption='Initial Days Stayed' datatype='string' name='[Calculation_1626080992976384006]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([Initial_days] / 5) * 5) + &quot; - &quot; +&#13;&#10;STR(INT([Initial_days] / 5) * 5 + 4)' />
            </column>
            <column caption='Case Order Groups' datatype='string' name='[Calculation_1626080992977055753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([CaseOrder] / 400) * 400) + &quot; - &quot; +&#13;&#10;STR(INT([CaseOrder] / 400) * 400 + 399)' />
            </column>
            <column caption='Total Charges' datatype='string' name='[Calculation_1626080993010626570]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([TotalCharge] / 200) * 200) + &quot; - &quot; +&#13;&#10;STR(INT([TotalCharge] / 200) * 200 + 200)' />
            </column>
            <column caption='Additional Charges' datatype='string' name='[Calculation_1626080993011392524]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([Additional_charges] / 500) * 500) + &quot; - &quot; +&#13;&#10;STR(INT([Additional_charges] / 500) * 500 + 500)' />
            </column>
            <column caption='NumRecords' datatype='integer' name='[Calculation_2133298895683022848]' role='measure' type='quantitative'>
