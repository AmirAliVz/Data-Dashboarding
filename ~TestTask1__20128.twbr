            <run fontalignment='1' fontcolor='#000000' fontname='Tw Cen MT Condensed Extra Bold'>Readmission Rates by Patient Condition</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontname='Tw Cen MT Condensed Extra Bold' fontsize='16'>&lt;[Parameters].[Parameter 2]&gt;</run>
          </formatted-text>
